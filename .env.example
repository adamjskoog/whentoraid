# Copy to .env.local and fill in to run WhenToRaid with a Supabase backend.
# Leave both blank for browser-only mode.
#
# Local: `npm run db:start` prints API_URL and PUBLISHABLE_KEY.
# Hosted: Supabase dashboard > Project Settings > API.
# The publishable key is safe to ship to browsers; never put the secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
